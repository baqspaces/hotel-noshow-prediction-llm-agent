{
  "info": {
    "_postman_id": "b5d9884c-9f2f-4e4d-a0b6-visa-noshow-demo",
    "name": "Hotel No-Show AI API",
    "description": "Postman collection for the Hotel No-Show Prediction with AI-Powered Insights Dashboard. Start the FastAPI app first, run Auth / Login, then run the protected analytics, risk, and assistant requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Monitoring",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Public health check showing app status, environment, raw booking table, and active analytics table."
          }
        },
        {
          "name": "Monitoring",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/monitoring",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "monitoring"
              ]
            },
            "description": "Protected monitoring endpoint with cache and database pool status."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('login returns access token', function () {",
                  "  pm.expect(json.access_token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('access_token', json.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"manager\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Returns a bearer token for protected endpoints. The test script saves it into the collection variable `access_token`."
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
