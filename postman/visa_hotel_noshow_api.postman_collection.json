              ],
              "path": [
                "api",
                "bookings",
                "high-risk"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "25"
                },
                {
                  "key": "risk_band",
                  "value": "High"
                }
              ]
            },
            "description": "Operational queue rows with risk score, expected exposure, and intervention recommendation."
          }
        },
        {
          "name": "Predict Booking Risk",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
