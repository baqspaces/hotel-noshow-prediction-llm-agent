              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "dimensions"
              ]
            },
            "description": "Returns segment dimensions available for dashboard drill-down."
          }
        },
        {
          "name": "Segment Summary - Branch",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/segments?dimension=branch&min_bookings=20&limit=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "segments"
              ],
              "query": [
                {
                  "key": "dimension",
                  "value": "branch"
                },
                {
                  "key": "min_bookings",
                  "value": "20"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Returns no-show and revenue metrics by selected segment dimension."
