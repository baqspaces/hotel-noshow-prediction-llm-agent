              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branch\": \"Changi\",\n  \"platform\": \"Website\",\n  \"country\": \"China\",\n  \"room\": \"Single\",\n  \"first_time_flag\": 1,\n  \"customer_status\": \"First-time\",\n  \"price\": 250\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/predict",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "predict"
              ]
            },
            "description": "Returns a lightweight risk estimate and intervention recommendation for a single booking-like payload."
          }
        }
      ]
    },
    {
      "name": "AI Assistant",
      "item": [
        {
          "name": "Ask Assistant - Executive Summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('assistant returns answer and provider', function () {",
                  "  pm.expect(json.answer).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.provider).to.be.oneOf(['openai', 'deterministic_fallback']);",
                  "});",
                  "pm.test('assistant returns trace and retrieved evidence fields', function () {",
                  "  pm.expect(json.agent_trace).to.be.an('array');",
                  "  pm.expect(json.retrieved_insights).to.be.an('array');",
                  "  pm.expect(json.matched_segment_metrics).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Give me an executive summary of no-show risk.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/assistant/query",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "assistant",
                "query"
              ]
            },
            "description": "Asks the current OpenAI/fallback assistant for grounded insights using retrieved dashboard evidence. Response includes `answer`, `retrieved_insights`, `matched_segment_metrics`, `agent_trace`, and `provider`. The current demo implements OpenAI only; future providers require provider-specific config and client code."
          }
        },
        {
          "name": "Ask Assistant - Interventions",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('assistant returns intervention answer and provider', function () {",
                  "  pm.expect(json.answer).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.provider).to.be.oneOf(['openai', 'deterministic_fallback']);",
                  "});",
                  "pm.test('assistant response includes observability fields', function () {",
                  "  pm.expect(json.agent_trace).to.be.an('array');",
                  "  pm.expect(json.retrieved_insights).to.be.an('array');",
                  "  pm.expect(json.matched_segment_metrics).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What actions should we take for high-risk bookings?\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/assistant/query",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "assistant",
                "query"
              ]
            },
            "description": "Tests operational intervention recommendations, assistant grounding, provider labeling, and traceability fields."
          }
        }
      ]
    }
