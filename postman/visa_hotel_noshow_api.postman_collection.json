                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/summary",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "summary"
              ]
            },
            "description": "Dashboard KPI summary including bookings, no-show rate, and revenue at risk."
          }
        },
        {
